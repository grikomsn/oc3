{
  "name": "@nbrst/oc3",
  "version": "0.0.1",
  "description": "Minimal OpenCode Console proxy for Codex and ChatGPT desktop",
  "type": "module",
  "bin": {
    "oc3": "./src/cli.ts"
  },
  "scripts": {
    "oc3": "bun src/cli.ts",
    "serve": "bun src/cli.ts serve",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "compile": "bun build ./src/cli.ts --compile --minify --outfile ./dist/oc3"
  },
  "dependencies": {
    "@opentui/core": "^0.1.26"
  },
  "devDependencies": {
    "@opentui/core-darwin-arm64": "0.1.107",
    "@opentui/core-darwin-x64": "0.1.107",
    "@opentui/core-linux-arm64": "0.1.107",
    "@opentui/core-linux-x64": "0.1.107",
    "@types/bun": "^1.2.0",
    "typescript": "^5.8.0"
  },
  "private": true,
  "publishConfig": {
    "access": "public"
  }
}
